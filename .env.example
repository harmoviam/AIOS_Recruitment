# Local development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/harmoviajobs_courses_db
DB_SCHEMA=harmirecruit
JWT_SECRET=change-me-in-production
PORT=3010

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────
# Leave WHATSAPP_ENABLED=false for development: messages are then only
# stored in the local inbox ("simulated" mode). To go live:
#   1. Create a Meta App (developers.facebook.com) with the WhatsApp product.
#   2. WhatsApp → API Setup: copy the Phone Number ID; create a System User
#      permanent token with whatsapp_business_messaging permission.
#   3. Configure webhook: https://<your-domain>/api/whatsapp/webhook with the
#      verify token below; subscribe to the "messages" field.
#   4. Set the values below and restart the server.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ── AI (Anthropic Claude) ──────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty for development: reply suggestions, candidate
# scores, follow-up scripts and job descriptions then fall back to the
# built-in heuristics/templates ("disabled" mode). To go live, create an API
# key at platform.claude.com and set it below. AI_ENABLED=false force-disables
# the integration even when a key is present.
ANTHROPIC_API_KEY=
AI_ENABLED=true
ANTHROPIC_MODEL=claude-opus-4-8

# ── Resume uploads (Module 1) ───────────────────────────────────────
# RESUME_UPLOAD_DIR=server/uploads
# RESUME_MAX_SIZE_MB=10

# ── Resume parser service (Python: pdfplumber + python-docx + spaCy) ─
# Setup once: npm run parser:setup   Start: npm run dev:parser (auto with npm run dev)
# Text extraction uses the Python service when reachable, falling back to
# pdf-parse/mammoth. Structured parsing uses Claude when configured,
# falling back to the spaCy heuristic profile.
# On Cloud Run this is set automatically on deploy (private harmirecruit-parser
# service; requests are authenticated with an IAM identity token).
# RESUME_PARSER_URL=http://localhost:8020
# RESUME_PARSER_TIMEOUT_MS=30000

# Optional: embed real walkthrough videos (YouTube/Loom embed URLs)
# VITE_WALKTHROUGH_VIDEO_PLATFORM=
# VITE_WALKTHROUGH_VIDEO_ORG_ADMIN=
# VITE_WALKTHROUGH_VIDEO_HM=
# VITE_WALKTHROUGH_VIDEO_RECRUITER=

# ── LiveKit (in-app video interviews) ────────────────────────────
# Started automatically via `npm run dev` (docker compose service `livekit`).
# Manual: npm run livekit:up
# Self-host docs: https://docs.livekit.io/transport/self-hosting/local/
# Or use LiveKit Cloud (free tier): https://cloud.livekit.io
# APP_PUBLIC_URL is the browser URL candidates use to open join links.
# In Cloud Run this is set automatically on deploy; override for custom domains.
APP_PUBLIC_URL=http://localhost:5174
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloud Run — app project aiosrecruitment, DB cross-project in harmoviajobs
# DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@/harmoviajobs_courses_db?host=/cloudsql/harmoviajobs:us-central1:harmoviajobs-db-us1&schema=harmirecruit
# PORT=8080
