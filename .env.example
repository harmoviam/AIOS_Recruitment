# Local development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/harmoviajobs_courses_db
DB_SCHEMA=harmirecruit
JWT_SECRET=change-me-in-production
PORT=3010

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────
# Leave WHATSAPP_ENABLED=false for development: messages are then only
# stored in the local inbox ("simulated" mode). To go live:
#   1. Create a Meta App (developers.facebook.com) with the WhatsApp product.
#   2. WhatsApp → API Setup: copy the Phone Number ID; create a System User
#      permanent token with whatsapp_business_messaging permission.
#   3. Configure webhook: https://<your-domain>/api/whatsapp/webhook with the
#      verify token below; subscribe to the "messages" field.
#   4. Set the values below and restart the server.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ── AI (any OpenAI-compatible endpoint: vLLM, Ollama, OpenAI, …) ────
# Leave AI_BASE_URL and AI_API_KEY empty for development: reply suggestions,
# candidate scores, follow-up scripts and job descriptions then fall back to
# the built-in heuristics/templates ("disabled" mode).
#
# Self-hosted (no API key needed):
#   Ollama local:  AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen3:8b
#                  (install: https://ollama.com — then `ollama pull qwen3:8b`)
#   vLLM cloud:    AI_BASE_URL=http://<your-gpu-host>:8000/v1
#                  AI_MODEL=Qwen/Qwen3.6-27B
#                  (serve: vllm serve Qwen/Qwen3.6-27B)
#
# Hosted providers (API key required, AI_BASE_URL for non-OpenAI):
#   OpenAI:        AI_API_KEY=sk-...                        AI_MODEL=gpt-5.5
#   GitHub Models: AI_BASE_URL=https://models.github.ai/inference
#                  AI_API_KEY=<github PAT>                  AI_MODEL=openai/gpt-4o
#
# AI_ENABLED=false force-disables the integration even when configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=true
# Request timeout in ms (default 60000). Raise to ~300000 for CPU-only Ollama.
# AI_TIMEOUT_MS=60000

# ── Resume uploads (Module 1) ───────────────────────────────────────
# RESUME_UPLOAD_DIR=server/uploads
# RESUME_MAX_SIZE_MB=10

# ── Resume parser service (Python: pdfplumber + python-docx + spaCy) ─
# Setup once: npm run parser:setup   Start: npm run dev:parser (auto with npm run dev)
# Text extraction uses the Python service when reachable, falling back to
# pdf-parse/mammoth. Structured parsing uses the AI model when configured,
# falling back to the spaCy heuristic profile.
# On Cloud Run this is set automatically on deploy (private harmirecruit-parser
# service; requests are authenticated with an IAM identity token).
# RESUME_PARSER_URL=http://localhost:8020
# RESUME_PARSER_TIMEOUT_MS=30000

# Optional: embed real walkthrough videos (YouTube/Loom embed URLs)
# VITE_WALKTHROUGH_VIDEO_PLATFORM=
# VITE_WALKTHROUGH_VIDEO_ORG_ADMIN=
# VITE_WALKTHROUGH_VIDEO_HM=
# VITE_WALKTHROUGH_VIDEO_RECRUITER=

# Google Maps — job address autocomplete & map pin (Places API + Maps JavaScript API)
# VITE_GOOGLE_MAPS_API_KEY=

# ── LiveKit (in-app video interviews) ────────────────────────────
# Started automatically via `npm run dev` (docker compose service `livekit`).
# Manual: npm run livekit:up
# Self-host docs: https://docs.livekit.io/transport/self-hosting/local/
# Or use LiveKit Cloud (free tier): https://cloud.livekit.io
# APP_PUBLIC_URL is the browser URL candidates use to open join links.
# In Cloud Run this is set automatically on deploy; override for custom domains.
APP_PUBLIC_URL=http://localhost:5174
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloud Run — app project aiosrecruitment, DB cross-project in harmoviajobs
# DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@/harmoviajobs_courses_db?host=/cloudsql/harmoviajobs:us-central1:harmoviajobs-db-us1&schema=harmirecruit
# PORT=8080

# ── Resume storage (GCS) ─────────────────────────────────────────────
# Leave empty for local development: resumes are stored on disk under
# RESUME_UPLOAD_DIR. In production (Cloud Run) set GCS_BUCKET so resumes
# survive restarts and scale-to-zero. The service account needs
# roles/storage.objectAdmin on the bucket. Create once:
#   gcloud storage buckets create gs://harmirecruit-resumes \
#     --project aiosrecruitment --location us-central1 --uniform-bucket-level-access
# GCS_BUCKET=
# GCS_PREFIX=resumes

# ── Transactional email (Resend — https://resend.com) ────────────────
# Leave empty for development: sends are skipped ("disabled" mode) and
# password reset keeps returning the dev reset link. To go live:
#   1. Verify your sending domain in Resend (SPF + DKIM on e.g.
#      mail.harmirecruit.com — never send from the root domain).
#   2. Set the values below and restart.
# Sends: password reset, interview invites (+ .ics), team invites,
# careers-page application confirmations. All logged in email_log.
# EMAIL_API_KEY=
# EMAIL_FROM="HarmiRecruit <notify@mail.harmirecruit.com>"
# EMAIL_ENABLED=true

# ── Razorpay billing (Orders + Checkout + HMAC verify) ───────────────
# Leave empty for development: Settings → Billing shows a payments-disabled
# banner and no order can be created. Keys from dashboard.razorpay.com
# (use rzp_test_* keys first; switch to live keys after KYC).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
